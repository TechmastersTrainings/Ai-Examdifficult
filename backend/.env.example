# Application Settings
PROJECT_NAME="AI BASED AUTOMATIC QUESTION PAPER DIFFICULTY ANALYZER"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# API Server Configuration
API_V1_PREFIX="/api/v1"
HOST="127.0.0.1"
PORT=8000

# Security (Replace with strong random secrets in production)
# Generate with: openssl rand -hex 32
SECRET_KEY="development_secret_key_change_in_production_32_bytes_min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Phase 3)
DATABASE_URL="sqlite:///./data/app.db"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Storage
UPLOAD_DIR="./backend/uploads"
REPORTS_DIR="./backend/reports"
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB limit
