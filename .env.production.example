# ==============================================================================
# AI BASED AUTOMATIC QUESTION PAPER DIFFICULTY ANALYZER - Production Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="AI BASED AUTOMATIC QUESTION PAPER DIFFICULTY ANALYZER"
VERSION="1.0.0"

# Networking
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS="https://your-institution.edu,https://exams.your-institution.edu"

# Cryptographic Security
# CRITICAL: Generate a strong 64-character hex secret using: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite (Standard persistent container volume):
DATABASE_URL=sqlite:///./data/app.db

# Or PostgreSQL (Production cluster recommendation):
# DATABASE_URL=postgresql+psycopg2://cognitive_user:SecurePostgresPassword!@postgres-db:5432/cognitivepulse_db

# File Storage & Limits
UPLOAD_DIR=/app/backend/uploads
REPORTS_DIR=/app/backend/reports
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB max document file size

# Frontend Configuration
NEXT_PUBLIC_API_URL=/api/v1
